generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PLAYER
  AGENT
  SUPER_AGENT
  MANAGER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  code      String   @unique // The Player Code from Excel
  name      String?
  password  String?  // Nullable until registered
  role      Role     @default(PLAYER)
  
  // Hierarchy
  clubId        String?
  clubName      String?
  managerId     String?
  manager       User?   @relation("ManagerSubordinates", fields: [managerId], references: [id]) // Manager can have clubs, super agents, agents, and players
  subordinates  User[]  @relation("ManagerSubordinates")
  
  agentId       String?
  agent         User?   @relation("AgentPlayers", fields: [agentId], references: [id])
  players       User[]  @relation("AgentPlayers")
  
  superAgentId  String?
  superAgent    User?   @relation("SuperAgentItems", fields: [superAgentId], references: [id]) // Can be agents or players
  superAgentSubordinates  User[]  @relation("SuperAgentItems")

  // Financials
  balance       Float   @default(0)
  rakeback      Float   @default(0) // Percentage
  
  gameSessions     GameSession[]
  playerRingTotals PlayerRingTotal[]

  /// Whole-club assignment: all members with no explicit managerId fall under this manager.
  clubFullAssignments ClubFullManager[] @relation("ClubFullManagers")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// When set, every user in `clubId` with `managerId = null` is in scope for `managerId`.
model ClubFullManager {
  clubId    String @id
  managerId String
  manager   User   @relation("ClubFullManagers", fields: [managerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cycle {
  id        String   @id @default(cuid())
  startDate DateTime @default(now())
  endDate   DateTime?
  status    String   @default("OPEN") // OPEN, CLOSED
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  gameSessions     GameSession[]
  playerRingTotals PlayerRingTotal[]
}

model GameSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  date      DateTime
  tableName String
  gameType  String?
  
  buyIn     Float
  cashOut   Float
  pnl       Float // Profit and Loss
  
  // Extra fields from excel
  hands     Int?
  rake      Float?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  cycleId   String?
  cycle     Cycle?   @relation(fields: [cycleId], references: [id])
}

/// Ring-game totals per player per import period (from Union Member Statistics).
/// Used with MTT session totals to compute cycle winnings and rake.
model PlayerRingTotal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  cycleId    String
  cycle      Cycle    @relation(fields: [cycleId], references: [id])
  periodDate DateTime /// Import/session date (one row per player per import)
  totalPnl   Float    /// Total ring-game winnings for this period
  totalRake  Float    /// Total ring-game rake for this period

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, cycleId, periodDate])
}

model ImportLog {
  id          String   @id @default(cuid())
  fileName    String
  periodStart DateTime
  periodEnd   DateTime
  
  status      String   @default("SUCCESS")
  
  createdAt   DateTime @default(now())
}
